# /etc/ebs-planner.env 로 복사한 뒤 값을 채운다 (권한 600, 저장소에 올리지 말 것)
# ADB 콘솔 > 데이터베이스 연결 > TLS 연결 문자열 중 *_low 를 jdbc:oracle:thin:@ 뒤에 붙인다
EBS_DB_URL=jdbc:oracle:thin:@(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.ap-seoul-1.oraclecloud.com))(connect_data=(service_name=xxxx_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
EBS_DB_USER=EBSAPP
EBS_DB_PASSWORD=
